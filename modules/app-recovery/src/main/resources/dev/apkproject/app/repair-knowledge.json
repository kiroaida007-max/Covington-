    {
      "id": "reference-int-overflow",
      "rule": "int-overflow",
      "tags": [
        "long",
        "mul-long",
        "mul-int",
        "overflow",
        "promotion"
      ],
      "before": "long x = a * b;",
      "after": "long x = ((long) a) * b;",
      "explanation": "Java int multiplication overflows before assignment to long. Original mul-long may need widening before multiplication; original mul-int followed by int-to-long must retain int overflow.",
